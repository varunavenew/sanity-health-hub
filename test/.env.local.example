# Copy to .env.local and fill in (never commit .env.local)
#
# Dataset is REQUIRED — there is no silent production fallback in code.
# Local development MUST use developer.
# Vercel production MUST set production.

# Required — Sanity write token (Editor role) from https://www.sanity.io/manage
SANITY_TOKEN=skYOUR_TOKEN_HERE

# Required — project + dataset (local sandbox)
SANITY_PROJECT_ID=9jhqpk3a
SANITY_DATASET=developer
NEXT_PUBLIC_SANITY_PROJECT_ID=9jhqpk3a
NEXT_PUBLIC_SANITY_DATASET=developer

# Required for Sanity Studio (browser) — Vite only exposes SANITY_STUDIO_*
SANITY_STUDIO_PROJECT_ID=9jhqpk3a
SANITY_STUDIO_DATASET=developer

# Production migrations only (never set for routine local work):
# ALLOW_PRODUCTION_MIGRATION=true

# Optional — AI translation (otherwise free Lingva/MyMemory)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
LOVABLE_API_KEY=

# Google Maps — location picker in Studio (Maps JavaScript API + Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAkUB2wNYn1M-hYXI73rydQR4r5Hoejklk

# Translation backfill tuning
# TRANSLATE_PROVIDER=lingva
# TRANSLATE_DELAY_MS=1000
# DRY_RUN=1
# FORCE=1
# ONLY=homepage,article
